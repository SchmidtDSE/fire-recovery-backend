{
  "type": "kubernetes",
  "kubernetes": {
    "context": "kind-dispatcher",
    "namespace": "fire-severity-dev",
    "image": "fire-recovery-backend:no-such-tag",
    "pod_s3_endpoint": "rustfs.fire-severity-dev.svc.cluster.local:9000",
    "resources": {
      "requests": { "cpu": "1", "memory": "2Gi" },
      "limits": { "cpu": "1", "memory": "2Gi" }
    },
    "timeoutSeconds": 60,
    "ttlSecondsAfterFinished": 600,
    "threads": 1,
    "scratchSize": "2Gi"
  }
}
