            "title": "Job Id",
            "type": "string"
          },
          "pipeline_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pipeline Version"
          },
          "scene_counts": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scene Counts"
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "state"
        ],
        "title": "SeverityStatus",
        "type": "object"
      },
      "TileRange": {
        "additionalProperties": false,
        "description": "An inclusive range of WebMercatorQuad tiles at one zoom: the spatial key.",
        "properties": {
          "tms": {
            "const": "WebMercatorQuad",
            "default": "WebMercatorQuad",
            "title": "Tms",
            "type": "string"
          },
          "x": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "X",
            "type": "array"
          },
          "y": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Y",
            "type": "array"
          },
          "z": {
            "title": "Z",
            "type": "integer"
          }
        },
        "required": [
          "z",
          "x",
          "y"
        ],
        "title": "TileRange",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionResponse": {
        "description": "What this deployment is running.",
        "properties": {
          "git_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Commit the running image was built from, if known",
            "title": "Git Sha"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Image, by digest, that analysis Jobs run, if configured",
            "title": "Image"
          },
          "pipeline_version": {
            "description": "Pipeline version; part of every job id (D3)",
            "title": "Pipeline Version",
            "type": "integer"
          }
        },
        "required": [
          "pipeline_version"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Fire severity analysis: submit a perimeter and two date windows, poll a status URL, and get a Portolan catalog of dNBR, RdNBR and RBR.",
    "title": "Fire Recovery Backend",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Root  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "Root"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness check. Touches no storage and no cluster.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "Health"
        ]
      }
    },
    "/v2/severity": {
      "post": {
        "description": "Submit an analysis, or get the existing one for the same key.\n\nRequests whose perimeters snap to the same tiles, with the same name,\nwindows and sensor, share one job id and one analysis. The status URL\nalways works; the optional email reaches the requester whose submission\nstarts the job.",
        "operationId": "submit_severity_v2_severity_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeverityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeverityResult"
                }
              }
            },
            "description": "Already computed: the links"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeverityAccepted"
                }
              }
            },
            "description": "Queued or running: poll status_url"
          },
          "422": {
            "description": "Invalid request, or an area beyond the limits"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Too many requests; see Retry-After"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Storage or job dispatch unavailable"
          }
        },
        "summary": "Submit Severity",
        "tags": [
          "Severity v2"
        ]
      }
    },
    "/v2/severity/{job_id}": {
      "get": {
        "description": "An analysis's state, its links when done, and its error when failed.",
        "operationId": "severity_status_v2_severity__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeverityStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Severity Status",
        "tags": [
          "Severity v2"
        ]
      }
    },
    "/version": {
      "get": {
        "description": "The pipeline version and build this deployment runs. Does no I/O.",
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Version",
        "tags": [
          "Health"
        ]
      }
    }
  }
}