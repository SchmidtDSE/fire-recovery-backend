      "SeverityRequest": {
        "description": "Request for a fire severity analysis.",
        "example": {
          "fire_event_name": "Geology_Fire",
          "geometry": {
            "coordinates": [
              [
                [
                  -116.098276,
                  33.929925
                ],
                [
                  -116.098276,
                  33.880794
                ],
                [
                  -116.019318,
                  33.880794
                ],
                [
                  -116.019318,
                  33.929925
                ],
                [
                  -116.098276,
                  33.929925
                ]
              ]
            ],
            "type": "Polygon"
          },
          "postfire_window": [
            "2023-06-17",
            "2023-06-22"
          ],
          "prefire_window": [
            "2023-06-01",
            "2023-06-09"
          ],
          "sensor": "sentinel-2"
        },
        "properties": {
          "email": {
            "anyOf": [
              {
                "maxLength": 254,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional address to email when the analysis finishes. Never stored; the status URL works without it.",
            "title": "Email"
          },
          "fire_event_name": {
            "description": "Name of the fire event: letters, digits, '_' and '-' only. Validated, never transformed; it is part of the job id.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Fire Event Name",
            "type": "string"
          },
          "geometry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Polygon"
              },
              {
                "$ref": "#/components/schemas/MultiPolygon"
              },
              {
                "$ref": "#/components/schemas/Feature"
              }
            ],
            "description": "Fire perimeter: a Polygon, a MultiPolygon, or a Feature holding one. Only its bounds are used, and it is not stored.",
            "title": "Geometry"
          },
          "postfire_window": {
            "description": "[start, end] as ISO dates or datetimes (naive values are UTC). The end date includes its whole day. Hashed verbatim, so '2023-06-01' and '2023-06-01T00:00:00' are different requests.",
            "items": {
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Postfire Window",
            "type": "array"
          },
          "prefire_window": {
            "description": "[start, end] as ISO dates or datetimes (naive values are UTC). The end date includes its whole day. Hashed verbatim, so '2023-06-01' and '2023-06-01T00:00:00' are different requests.",
            "items": {
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Prefire Window",
            "type": "array"
          },
          "sensor": {
            "default": "sentinel-2",
            "description": "Satellite source: 'sentinel-2' (default) or 'landsat'",
            "enum": [
              "sentinel-2",
              "landsat"
            ],
            "title": "Sensor",
            "type": "string"
          }
        },
        "required": [
          "fire_event_name",
          "geometry",
          "prefire_window",
          "postfire_window"
        ],
        "title": "SeverityRequest",
        "type": "object"
      },
