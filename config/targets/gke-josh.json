{
  "type": "kubernetes",
  "kubernetes": {
    "context": "gke_dse-nps_us-west1_josh-k8s-gke",
    "gke": {
      "project": "dse-nps",
      "location": "us-west1",
      "cluster": "josh-k8s-gke"
    },
    "namespace": "fire-severity-dev",
    "image": "ghcr.io/schmidtdse/fire-recovery-backend/severity-batch:latest",
    "resources": {
      "requests": { "cpu": "2", "memory": "2Gi", "ephemeral-storage": "10Gi" },
      "limits": { "cpu": "2", "memory": "2Gi", "ephemeral-storage": "10Gi" }
    },
    "timeoutSeconds": 21600,
    "ttlSecondsAfterFinished": 86400,
    "spot": true,
    "threads": 2,
    "scratchSize": "10Gi"
  }
}
